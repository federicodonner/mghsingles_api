generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model card {
  id            Int            @id @default(autoincrement())
  scryfallid    String?
  conditionid   Int
  languageid    Int
  quantity      Int
  collectionid  Int            @default(autoincrement())
  variant       String?
  approved      Boolean        @default(true)
  price         Float?
  priceupdate   Int?
  ckuri         String?
  collection    collection     @relation(fields: [collectionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "card_collection")
  cardcondition cardcondition  @relation(fields: [conditionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "card_condition")
  cardlanguage  cardlanguage   @relation(fields: [languageid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "card_language")
  cardgeneral   cardgeneral?   @relation(fields: [scryfallid], references: [scryfallid], onDelete: NoAction, onUpdate: NoAction, map: "card_cardgeneral")
  cardplacement cardplacement[]
  orderline     orderline[]
}

model cardcondition {
  id   Int    @id @default(autoincrement())
  name String
  card card[]
  sale sale[]
}

model cardgeneral {
  scryfallid      String  @id
  name            String
  cardsetcode     String
  cardsetname     String
  image           String?
  borderless      Boolean @default(false)
  showcase        Boolean @default(false)
  phyrexian       Boolean @default(false)
  extendedart     Boolean @default(false)
  retroframe      Boolean @default(false)
  releasedatyear  Int?
  boxtopper       Boolean @default(false)
  color           String?
  rarity          String?
  collectornumber String?
  priceusd        Decimal? @db.Decimal(10, 2)
  priceusdfoil    Decimal? @db.Decimal(10, 2)
  priceeur        Decimal? @db.Decimal(10, 2)
  pricesupdated   Int?
  cardset         cardset @relation(fields: [cardsetcode], references: [cardset])
  card            card[]
  sale            sale[]
}

model cardlanguage {
  id   Int    @id @default(autoincrement())
  name String
  card card[]
  sale sale[]
}

model cardset {
  cardsetname String
  releasedate DateTime
  iconsvguri  String?
  cardset     String        @id
  cardgeneral cardgeneral[]
}

model collection {
  id           Int            @id @default(autoincrement())
  playerid     Int
  active       Boolean        @default(true)
  percent      Decimal?       @db.Decimal(5, 4)
  name         String?
  card         card[]
  player       player         @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "collection_player")
  payment      payment[]      @ignore
  sale         sale[]
}

model login {
  id       Int      @id @default(autoincrement())
  playerid Int
  token    String
  date     DateTime
  player   player   @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "login_player")
}

model payment {
  id           Int        @id @default(autoincrement())
  date         Int
  ammount      Decimal    @db.Decimal(10, 2)
  collectionid Int
  collection   collection @relation(fields: [collectionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_collection")
}

model player {
  id           Int          @id @default(autoincrement())
  username     String
  name         String
  email        String
  superuser    Boolean      @default(false)
  passwordhash String
  collection   collection[]
  storage      storage[]
  order        order[]
  wishlist     wishlist[]
  login        login[]      @ignore
}

model sale {
  id            Int           @id @default(autoincrement())
  collectionid  Int
  scryfallid    String
  price         Decimal       @db.Decimal(10, 2)
  percent       Decimal       @db.Decimal(5, 4)
  quantity      Int
  date          Int
  conditionid   Int
  languageid    Int
  foil          Boolean       @default(false)
  collection    collection    @relation(fields: [collectionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_collection")
  cardcondition cardcondition @relation(fields: [conditionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_condition")
  cardlanguage  cardlanguage  @relation(fields: [languageid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_language")
  cardgeneral   cardgeneral   @relation(fields: [scryfallid], references: [scryfallid], onDelete: NoAction, onUpdate: NoAction, map: "sale_cardgeneral")
}

/// A physical container in the shop or in a customer's hands.
///
/// `playerid` null means the shop owns it. A customer-owned container can be
/// left in the shop to sell from (`inshop` true) or taken home (`inshop`
/// false), at which point its cards are out of the shop's sellable inventory.
model storage {
  id            Int             @id @default(autoincrement())
  name          String
  type          storagetype
  playerid      Int?
  inshop        Boolean         @default(true)
  player        player?         @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "storage_player")
  cardplacement cardplacement[]

  @@index([playerid])
}

/// Where one physical copy of a card row lives.
///
/// A `card` row carries a quantity, so `copyindex` (1-based) identifies which
/// of those copies this is — the shop can split four Bolts across a binder and
/// a box. Binder placements use page/pocket/depth; sorted boxes use sequence;
/// unsorted boxes use none of them.
model cardplacement {
  id        Int     @id @default(autoincrement())
  cardid    Int
  copyindex Int
  storageid Int
  page      Int?
  pocket    Int?
  depth     Int?
  sequence  Int?
  card      card    @relation(fields: [cardid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cardplacement_card")
  storage   storage @relation(fields: [storageid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cardplacement_storage")

  @@unique([cardid, copyindex], map: "cardplacement_copy_unique")
  @@index([storageid, page, pocket, depth])
  @@index([storageid, sequence])
}

enum storagetype {
  binder
  sorted_box
  unsorted_box
}

/// A customer's reservation. Nothing is paid online — the shop holds the cards
/// and money changes hands in person, so an order is a promise plus a deadline.
///
/// `expires` stops a forgotten order removing stock from sale forever. It is
/// enforced lazily (see releaseExpiredOrders) rather than by a scheduler, so
/// availability is always correct at the moment it is read.
model order {
  id        Int         @id @default(autoincrement())
  playerid  Int
  status    orderstatus @default(pending)
  created   Int
  expires   Int?
  closed    Int?
  note      String?
  player    player      @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_player")
  orderline orderline[]

  @@index([status])
  @@index([playerid])
}

/// One card row on an order.
///
/// `price` is the per-unit price captured when the order was placed, not a
/// live lookup: a customer pays what they were quoted even if the card is
/// repriced before they collect it.
model orderline {
  id       Int     @id @default(autoincrement())
  orderid  Int
  cardid   Int
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  order    order   @relation(fields: [orderid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderline_order")
  card     card    @relation(fields: [cardid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderline_card")

  @@unique([orderid, cardid], map: "orderline_order_card_unique")
  @@index([cardid])
}

/// A card a customer is looking for, held by NAME rather than by printing:
/// someone after a Lightning Bolt usually means any Bolt, and matching by name
/// is what makes the shop's aggregated demand list worth reading.
model wishlist {
  id       Int    @id @default(autoincrement())
  playerid Int
  name     String
  created  Int
  /// Constraints, each independent of the others. An EMPTY list means "any" —
  /// so a customer can pin the printing while accepting any language, or accept
  /// any printing in only English or Spanish, foil only. Several values in one
  /// list are alternatives: "either of these three versions".
  ///
  /// Held as arrays rather than join tables because they are small, bounded,
  /// owned entirely by this row and never queried on their own.
  versions     String[]
  languageids  Int[]
  conditionids Int[]
  variants     String[]
  player   player @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "wishlist_player")

  @@unique([playerid, name], map: "wishlist_player_name_unique")
}

enum orderstatus {
  pending
  completed
  cancelled
  expired
}
