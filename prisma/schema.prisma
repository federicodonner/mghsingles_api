generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model card {
  id            Int            @id @default(autoincrement())
  scryfallid    String?
  conditionid   Int
  languageid    Int
  quantity      Int
  collectionid  Int            @default(autoincrement())
  /// Which finish this physical copy is, in Scryfall's vocabulary: nonfoil,
  /// foil or etched. Required — it used to be nullable and held a mix of NULL,
  /// "" and "normal" for the same thing.
  variant       String         @default("nonfoil")
  approved      Boolean        @default(true)
  /// What the shop SELLS this copy for. Written by the price import from the
  /// CardKingdom retail reference times the condition's sell multiplier, unless
  /// `pricelocked` is set.
  price         Decimal?       @db.Decimal(10, 2)
  /// What the shop PAYS for one — derived from CardKingdom's buylist. Tracked
  /// separately from `price` because they move independently and the shop edits
  /// them independently.
  buyprice      Decimal?       @db.Decimal(10, 2)
  /// Set when a human fixed the price by hand. The import then leaves it alone,
  /// which is the whole point: a card can be priced off-market deliberately.
  pricelocked    Boolean       @default(false)
  buypricelocked Boolean       @default(false)
  priceupdate   Int?
  buypriceupdate Int?
  ckuri         String?
  collection    collection     @relation(fields: [collectionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "card_collection")
  cardcondition cardcondition  @relation(fields: [conditionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "card_condition")
  cardlanguage  cardlanguage   @relation(fields: [languageid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "card_language")
  cardgeneral   cardgeneral?   @relation(fields: [scryfallid], references: [scryfallid], onDelete: NoAction, onUpdate: NoAction, map: "card_cardgeneral")
  cardplacement cardplacement[]
  orderline     orderline[]
  wishlistmatch wishlistmatch[]
}

model cardcondition {
  id   Int    @id @default(autoincrement())
  name String
  /// Fraction of the NM reference this condition is worth.
  ///
  /// CardKingdom quotes ONE price per printing, which is the NM price, so every
  /// other grade is derived from it. Sell and buy are separate multipliers
  /// because a shop need not discount what it pays at the same rate it
  /// discounts what it charges — set them equal if you want them to move
  /// together. Editable from the admin config page.
  sellmultiplier Decimal @default(1) @db.Decimal(5, 4)
  buymultiplier  Decimal @default(1) @db.Decimal(5, 4)
  card card[]
  sale sale[]
}

model cardgeneral {
  scryfallid      String  @id
  name            String
  cardsetcode     String
  cardsetname     String
  image           String?
  borderless      Boolean @default(false)
  showcase        Boolean @default(false)
  phyrexian       Boolean @default(false)
  extendedart     Boolean @default(false)
  retroframe      Boolean @default(false)
  releasedatyear  Int?
  boxtopper       Boolean @default(false)
  color           String?
  rarity          String?
  collectornumber String?
  /// Which finishes this printing was actually produced in, straight from
  /// Scryfall's `finishes`: nonfoil, foil, etched. Half of all printings exist
  /// in only one of them — 38% are nonfoil-only and 12% are foil-only — so this
  /// is what stops the shop recording a foil copy of a card that has no foil,
  /// or offering a foil filter for one.
  finishes        String[] @default([])
  /// Where this printing exists, straight from Scryfall's `games`: paper,
  /// mtgo, arena. The shop sells cardboard, so a printing without `paper` in
  /// this list must never reach the store — an Alchemy rebalance or an
  /// Arena-only promo cannot be put in a binder.
  ///
  /// The importer already refuses to write a non-paper row, so in practice
  /// every value here contains "paper". It is stored anyway because that makes
  /// the invariant checkable in SQL rather than only true by assertion, and
  /// because "also on mtgo" is real information about a real card.
  games           String[] @default([])
  /// MTGJSON's own id for this printing. Stored once so the DAILY price file
  /// (5MB) can be joined without re-downloading the identifier map (15MB), which
  /// never changes for an existing printing.
  mtgjsonuuid     String?
  priceusd        Decimal? @db.Decimal(10, 2)
  priceusdfoil    Decimal? @db.Decimal(10, 2)
  priceusdetched  Decimal? @db.Decimal(10, 2)
  priceeur        Decimal? @db.Decimal(10, 2)
  pricesupdated   Int?
  cardset         cardset @relation(fields: [cardsetcode], references: [cardset])
  card            card[]
  sale            sale[]
  cardprice       cardprice[]

  @@index([mtgjsonuuid])
}

model cardlanguage {
  id   Int    @id @default(autoincrement())
  name String
  card card[]
  sale sale[]
}

model cardset {
  cardsetname String
  releasedate DateTime
  iconsvguri  String?
  /// Scryfall's `digital` flag: the set exists only on Arena or MTGO. Kept
  /// rather than skipped so the row stays available to any historical
  /// cardgeneral that references it, and filtered out of the set list the
  /// admin picks from — an all-digital set can only ever be an empty option.
  digital     Boolean       @default(false)
  cardset     String        @id
  cardgeneral cardgeneral[]
}

model collection {
  id           Int            @id @default(autoincrement())
  playerid     Int
  active       Boolean        @default(true)
  percent      Decimal?       @db.Decimal(5, 4)
  name         String?
  card         card[]
  player       player         @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "collection_player")
  payment      payment[]      @ignore
  sale         sale[]
}

model login {
  id       Int      @id @default(autoincrement())
  playerid Int
  token    String
  date     DateTime
  player   player   @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "login_player")
}

model payment {
  id           Int        @id @default(autoincrement())
  date         Int
  ammount      Decimal    @db.Decimal(10, 2)
  collectionid Int
  collection   collection @relation(fields: [collectionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "payment_collection")
}

model player {
  id           Int          @id @default(autoincrement())
  username     String
  name         String
  email        String
  /// What this account may do. Replaces the old `superuser` boolean, which
  /// could not express the difference between someone who works the counter
  /// and someone who signs the payouts.
  ///
  /// customer — buys, consigns, wishlists. No access to the admin app.
  /// staff    — everything a shop hand needs: sell, stock, storage, orders.
  /// owner    — staff, plus money (payouts), pricing policy and user roles.
  role         playerrole   @default(customer)
  passwordhash String
  collection   collection[]
  storage      storage[]
  order        order[]
  wishlist     wishlist[]
  notification notification[]
  login        login[]      @ignore
}

model sale {
  id            Int           @id @default(autoincrement())
  collectionid  Int
  scryfallid    String
  price         Decimal       @db.Decimal(10, 2)
  percent       Decimal       @db.Decimal(5, 4)
  quantity      Int
  date          Int
  conditionid   Int
  languageid    Int
  foil          Boolean       @default(false)
  collection    collection    @relation(fields: [collectionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_collection")
  cardcondition cardcondition @relation(fields: [conditionid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_condition")
  cardlanguage  cardlanguage  @relation(fields: [languageid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sale_language")
  cardgeneral   cardgeneral   @relation(fields: [scryfallid], references: [scryfallid], onDelete: NoAction, onUpdate: NoAction, map: "sale_cardgeneral")
}

/// A physical container in the shop or in a customer's hands.
///
/// `playerid` null means the shop owns it. A customer-owned container can be
/// left in the shop to sell from (`inshop` true) or taken home (`inshop`
/// false), at which point its cards are out of the shop's sellable inventory.
model storage {
  id            Int             @id @default(autoincrement())
  name          String
  type          storagetype
  playerid      Int?
  /// Where this container is in its lifecycle. Replaces the old `inshop`
  /// boolean, which could not distinguish "the customer asked for it back" from
  /// "the customer physically has it".
  ///
  ///   for_sale  — in the shop; its cards are on sale
  ///   retired   — the customer asked for it back. Cards come OFF sale at once,
  ///               though the container is still physically in the shop.
  ///   released  — handed back; the customer has it and may edit it
  ///   returning — the customer is bringing it in; the shop has not taken it yet
  ///
  /// Only `for_sale` puts cards on sale. A shop-owned container is always
  /// for_sale: there is nobody to hand it to.
  state         storagestate    @default(for_sale)
  player        player?         @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "storage_player")
  cardplacement cardplacement[]

  @@index([playerid])
}

/// Where one physical copy of a card row lives.
///
/// A `card` row carries a quantity, so `copyindex` (1-based) identifies which
/// of those copies this is — the shop can split four Bolts across a binder and
/// a box. Binder placements use page/pocket/depth; sorted boxes use sequence;
/// unsorted boxes use none of them.
model cardplacement {
  id        Int     @id @default(autoincrement())
  cardid    Int
  copyindex Int
  storageid Int
  page      Int?
  pocket    Int?
  depth     Int?
  sequence  Int?
  /// Set while this copy is sitting in a customer's pick-up bag.
  ///
  /// The placement is KEPT, not deleted: it is the only record of where the
  /// card came from, and a cancelled order has to be refiled. The card is not
  /// in that pocket right now, so anything showing container contents must
  /// exclude these — but the address survives until the order is fulfilled,
  /// at which point the card has left the shop and the row goes with it.
  orderlineid Int?
  card      card    @relation(fields: [cardid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cardplacement_card")
  storage   storage @relation(fields: [storageid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cardplacement_storage")
  orderline orderline? @relation(fields: [orderlineid], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "cardplacement_orderline")

  @@unique([cardid, copyindex], map: "cardplacement_copy_unique")
  @@index([storageid, page, pocket, depth])
  @@index([storageid, sequence])
}

enum storagetype {
  binder
  sorted_box
  unsorted_box
}

/// A customer's reservation. Nothing is paid online — the shop holds the cards
/// and money changes hands in person, so an order is a promise plus a deadline.
///
/// `expires` stops a forgotten order removing stock from sale forever. It is
/// enforced lazily (see releaseExpiredOrders) rather than by a scheduler, so
/// availability is always correct at the moment it is read.
model order {
  id        Int         @id @default(autoincrement())
  playerid  Int
  status    orderstatus @default(pending)
  created   Int
  expires   Int?
  closed    Int?
  note      String?
  player    player      @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "order_player")
  orderline orderline[]

  @@index([status])
  @@index([playerid])
}

/// One card row on an order.
///
/// `price` is the per-unit price captured when the order was placed, not a
/// live lookup: a customer pays what they were quoted even if the card is
/// repriced before they collect it.
model orderline {
  id       Int     @id @default(autoincrement())
  orderid  Int
  cardid   Int
  quantity Int
  price    Decimal @db.Decimal(10, 2)
  /// `purchase` is an ordinary sale. `withdrawal` is a customer collecting a
  /// card out of their OWN consigned collection: it leaves stock, but no money
  /// changes hands and no sale row is written, because there is nobody to pay.
  kind     orderlinekind @default(purchase)
  order    order   @relation(fields: [orderid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderline_order")
  card     card    @relation(fields: [cardid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "orderline_card")
  /// Where the copies in this line came from, so a cancellation can refile them.
  cardplacement cardplacement[]

  @@unique([orderid, cardid], map: "orderline_order_card_unique")
  @@index([cardid])
}

/// A card a customer is looking for, held by NAME rather than by printing:
/// someone after a Lightning Bolt usually means any Bolt, and matching by name
/// is what makes the shop's aggregated demand list worth reading.
model wishlist {
  id       Int    @id @default(autoincrement())
  playerid Int
  name     String
  created  Int
  /// Constraints, each independent of the others. An EMPTY list means "any" —
  /// so a customer can pin the printing while accepting any language, or accept
  /// any printing in only English or Spanish, foil only. Several values in one
  /// list are alternatives: "either of these three versions".
  ///
  /// Held as arrays rather than join tables because they are small, bounded,
  /// owned entirely by this row and never queried on their own.
  versions     String[]
  languageids  Int[]
  conditionids Int[]
  variants     String[]
  player   player @relation(fields: [playerid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "wishlist_player")

  wishlistmatch wishlistmatch[]

  @@unique([playerid, name], map: "wishlist_player_name_unique")
}

enum orderstatus {
  pending
  completed
  cancelled
  expired
}

/// One row per Scryfall sync attempt.
///
/// Exists so a scheduled run can tell whether there is anything new: Scryfall
/// stamps each bulk file with an id that changes only when it is regenerated,
/// so a run whose id matches the last successful one has nothing to do and
/// skips the 77MB download entirely. That is what makes a frequent schedule
/// cheap rather than wasteful.
///
/// It doubles as the answer to "when did this last run, and did it work?",
/// which a Heroku Scheduler job cannot otherwise tell you.
model syncrun {
  id          Int      @id @default(autoincrement())
  source      String
  bulkid      String?
  bulkupdated String?
  cards       Int      @default(0)
  sets        Int      @default(0)
  skipped     Boolean  @default(false)
  ok          Boolean  @default(false)
  error       String?
  started     Int
  finished    Int?

  @@index([source, ok, started])
}

/// A card in stock that satisfies somebody's wishlist entry.
///
/// Written by a scheduled job rather than on every add: matching is a
/// wishlist-by-stock comparison, and doing it on each write would run it
/// constantly to discover nothing. Persisting the result is what makes "new
/// since you last looked" possible — recomputing on page load could tell the
/// shop a match exists, but not that it is new.
model wishlistmatch {
  id         Int       @id @default(autoincrement())
  wishlistid Int
  cardid     Int
  /// Denormalised so the shop's queue can group by customer without joining
  /// through the wishlist every time.
  playerid   Int
  kind       matchkind
  found      Int
  resolved   Int?
  resolution String?
  wishlist   wishlist  @relation(fields: [wishlistid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlistmatch_wishlist")
  card       card      @relation(fields: [cardid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlistmatch_card")

  @@unique([wishlistid, cardid], map: "wishlistmatch_unique")
  @@index([playerid, resolved])
}

enum orderlinekind {
  purchase
  withdrawal
}

/// Mirrors orderlinekind: a match against a card in the customer's OWN
/// collection is something they can simply take back, not buy.
enum matchkind {
  purchase
  withdrawal
}

/// Something the shop wants a customer to know.
///
/// In-app only: there is no mail or push infrastructure in this project, and
/// inventing one here would mean credentials and a provider that do not exist.
/// A row here is exactly what a future mailer would read, so adding email later
/// is a job over this table rather than a rewrite.
///
/// `cardname` is a SNAPSHOT, not a join. The card row is deleted when the order
/// completes, so a notification that only referenced it by id would turn blank
/// precisely once the customer had collected the thing it was about.
model notification {
  id          Int     @id @default(autoincrement())
  playerid    Int
  kind        String
  cardname    String?
  cardsetcode String?
  variant     String?
  orderid     Int?
  created     Int
  readat      Int?
  player      player  @relation(fields: [playerid], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notification_player")

  @@index([playerid, readat])
}

/// Reference prices for a printing, from MTGJSON.
///
/// One row per printing per finish per source, rather than columns on
/// cardgeneral: MTGJSON ships several sources in the same payload, and a table
/// absorbs a new one without another schema change. Only CardKingdom is
/// ingested today.
///
/// `retail` is what the source SELLS at — the reference for pricing stock.
/// `buylist` is what it PAYS — the reference for taking cards in on
/// consignment. Both arrive free in the same file.
///
/// No history is kept. MTGJSON publishes the full history separately, so
/// accumulating our own would duplicate a dataset that already exists.
model cardprice {
  id          Int      @id @default(autoincrement())
  scryfallid  String
  source      String
  finish      String
  retail      Decimal? @db.Decimal(10, 2)
  buylist     Decimal? @db.Decimal(10, 2)
  currency    String?
  /// The date MTGJSON stamped the quote with, not when it was imported.
  pricedate   String?
  updated     Int
  cardgeneral cardgeneral @relation(fields: [scryfallid], references: [scryfallid], onDelete: Cascade, onUpdate: NoAction, map: "cardprice_cardgeneral")

  @@unique([scryfallid, source, finish], map: "cardprice_unique")
  @@index([source, finish])
}

enum playerrole {
  customer
  staff
  owner
}

enum storagestate {
  for_sale
  retired
  released
  returning
}
